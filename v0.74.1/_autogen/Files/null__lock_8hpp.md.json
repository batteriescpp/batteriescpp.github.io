  "programlisting": "//######=###=##=#=#=#=#=#==#==#====#+==#+==============+==+==+==+=+==+=+=+=+=+=+=+\n// Copyright 2026 Anthony Paul Astolfi\n//\n#pragma once\n#define BATTERIES_NULL_LOCK_HPP\n\n#include <batteries/type_traits.hpp>\n\nnamespace batt {\n\nclass NullLock\n{\n   public:\n    template <typename MutexT, typename = batt::EnableIfNoShadow<NullLock, MutexT&>>\n    explicit NullLock(MutexT&) noexcept\n    {\n    }\n\n    [[nodiscard]] bool changed() const noexcept\n    {\n        return false;\n    }\n};\n\n}  // namespace batt",
